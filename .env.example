# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Poll persistence: omit REDIS_URL locally to use in-memory storage (polls reset on restart).
# For production, set REDIS_URL. To force in-memory anywhere: POLL_STORAGE=memory
# REDIS_URL=redis://localhost:6379
# POLL_STORAGE=memory

# Google Sheets Service Account Configuration
# You can either provide the JSON file path or individual fields
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OR use JSON file path:
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./path/to/service-account-key.json

# Google Spreadsheet ID (already set to your spreadsheet)
SPREADSHEET_ID=1eX1xQF31-T2iGHTfFL3CZ1b-nVxOJKRqfvFCvGGGXGU
